# Konfiguracja serwera systim-mcp.
#
# Skopiuj ten plik do .env i uzupełnij wartości:  cp .env.example .env
# Plik .env jest w .gitignore i nie może trafić do repozytorium — zawiera hasło
# do API oraz klucz podpisujący.
#
# Wszystkie zmienne są walidowane raz, przy starcie procesu. Brak wymaganej
# zmiennej zatrzyma serwer z listą braków, zamiast wysypać się przy pierwszym
# wywołaniu narzędzia.


# ─────────────────────────────────────────────────────────────────────────────
# Dostęp do Systim (wymagane)
# ─────────────────────────────────────────────────────────────────────────────

# Poddomena konta — sama nazwa, bez .systim.pl i bez https://.
# Znajdziesz ją w adresie panelu: dla https://abcd.systim.pl wpisz abcd.
SYSTIM_KONTO=abcd

# Użytkownik z wygenerowanym hasłem API.
# Panel Systim → Ustawienia → Użytkownicy → wybrany użytkownik.
# UWAGA: token API nie podlega uprawnieniom — daje pełny dostęp do konta,
# łącznie z usuwaniem danych. Załóż osobnego użytkownika do integracji.
SYSTIM_LOGIN=api@firma.pl

# Hasło do API. To NIE jest hasło do logowania w przeglądarce — generuje się je
# osobno: Panel Systim → Ustawienia → Użytkownicy → edycja → „Hasło do API".
SYSTIM_PASS=

# ID szablonu dokumentu.
# Panel Systim → Ustawienia → Szablony wydruku. ID odczytasz z adresu URL przy
# edycji szablonu (parametr id). Nie ma metody API, która by je wylistowała.
# Bez tego pola API odrzuca dokument.
SYSTIM_ID_SZABLONU=

# ID serii numeracji — mapa: rodzaj dokumentu → ID numeracji.
#
# W Systim seria numeracji jest PRZYPISANA DO TYPU DOKUMENTU. Wysłanie numeracji
# faktury VAT przy rodzaju „pro forma" kończy się odrzuceniem dokumentu
# komunikatem „błędne przypisanie rodzaju dokumentu do numeracji".
#
# ID odczytasz w panelu: Ustawienia → Numeracja dokumentów (kolumna ID).
# Standardowe wartości Systim, użyte jako domyślne:
#
#   rodzaj  0  faktura VAT           → 1   (FV)
#   rodzaj  1  pro forma             → 5   (PF)
#   rodzaj  6  paragon fiskalny      → 39  (PFA)
#   rodzaj 15  paragon niefiskalny   → 9   (PA)
#   rodzaj 22  rachunek              → 16  (FA, faktura zw. z VAT)
#   rodzaj 26  oferta                → 21  (OF)
#
# Podane tu wartości nadpisują domyślne; brakujące rodzaje biorą wartość domyślną.
# Można też podać jedną liczbę (np. 1) — obowiązuje wtedy dla wszystkich rodzajów,
# ale zadziała tylko wtedy, gdy wystawiasz jeden typ dokumentu.
SYSTIM_ID_NUMERACJI={"0":1,"1":5}

# Mapowanie stawek VAT na ID stawek w Systim, jako JSON.
# Pole stawka_vat w API przyjmuje ID stawki, nie procent — to jedna z częstszych
# pomyłek przy tej integracji.
#
# ID odczytasz narzędziem lista_stawek_vat po pierwszym uruchomieniu serwera
# (patrz sekcja „Pierwsze uruchomienie" w README). Do czasu uzupełnienia tej
# zmiennej serwer wystartuje, ale nie policzy żadnej faktury.
#
# Klucze: procent bez znaku % albo oznaczenie stawki nieprocentowej (zw, np, oo).
SYSTIM_VAT_IDS={"23":1,"8":2,"5":3,"0":4,"zw":5}


# ─────────────────────────────────────────────────────────────────────────────
# Serwer
# ─────────────────────────────────────────────────────────────────────────────

# http  — docelowy tryb pracy: serwer zdalny na Streamable HTTP (domyślny)
# stdio — wyłącznie do lokalnego debugowania przez docker run -i
SYSTIM_TRANSPORT=http

# Adres nasłuchu wewnątrz kontenera.
SYSTIM_ADDR=:8000

# Katalog, do którego narzędzie pobierz_pdf zapisuje pliki.
# W docker-compose.yml jest tu podmontowany wolumen.
SYSTIM_KATALOG_PDF=/data/faktury

# Timeout pojedynczego wywołania HTTP do API Systim.
SYSTIM_TIMEOUT=30s

# debug | info | warn | error
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────────────────────────
# Bezpieczeństwo (wymagane w trybie http)
# ─────────────────────────────────────────────────────────────────────────────

# Publiczny adres serwera, pod którym widzi go Claude.
# Musi być HTTPS — Claude łączy się z chmury Anthropic, nie z urządzenia
# użytkownika, więc localhost, VPN i sieci firmowe nie zadziałają.
# Adres jest używany do Protected Resource Metadata i do walidacji Origin.
SYSTIM_PUBLIC_URL=https://mcp.firma.pl

# Klucz HMAC do podpisywania szkiców faktur, minimum 32 bajty.
# Szkice są samowystarczalnymi, podpisanymi tokenami, więc serwer da się
# zrestartować i zeskalować bez gubienia szkiców — pod warunkiem, że wszystkie
# instancje mają ten sam klucz.
# Wygeneruj:  openssl rand -base64 48
SYSTIM_SZKIC_KLUCZ=

# Adres serwera autoryzacji (issuer) — authentik.
#
# authentik pracuje domyślnie w trybie „per provider": issuer zawiera slug
# aplikacji i KOŃCZY SIĘ UKOŚNIKIEM.
#   https://auth.recoop.pl/application/o/<slug-aplikacji>/
#
# Slug sprawdzisz w authentik → Applications → wybrana aplikacja → pole Slug.
# Wartość musi być dokładnie taka, jak w polu "issuer" dokumentu:
#   https://auth.recoop.pl/application/o/<slug>/.well-known/openid-configuration
#
# Przy lokalnym profilu dev: http://127.0.0.1:9000/application/o/systim-mcp/
OIDC_ISSUER=https://auth.recoop.pl/application/o/systim-mcp/

# Oczekiwana wartość aud w tokenie dostępowym.
#
# authentik domyślnie wstawia do aud CLIENT_ID providera — i to jest najprostsza
# poprawna wartość, bo nie wymaga żadnego dodatkowego mapowania.
# Jeśli wolisz, żeby aud było adresem zasobu, zwróć {"aud": "..."} z własnego
# scope mappingu (przykład w deploy/authentik/blueprint-systim-mcp.yaml)
# i wpisz tutaj tę samą wartość.
OIDC_AUDIENCE=systim-mcp-connector

# Scope wymagany do wywołania narzędzi — sprawdzany w każdym tokenie.
OIDC_SCOPE=systim:faktury

# Scope'y, o które klient ma poprosić serwer autoryzacji. Trafiają do nagłówka
# WWW-Authenticate i do Protected Resource Metadata. To NIE to samo co OIDC_SCOPE:
# klient musi poprosić o więcej, niż sprawdzamy.
#
# offline_access jest tu kluczowy — authentik od wersji 2024.2 wyda refresh token
# TYLKO wtedy, gdy klient wprost o ten scope poprosił. Bez refresh tokenu konektor
# rozłączy się po wygaśnięciu tokenu dostępowego, co wygląda na przypadkową awarię.
#
# Domyślnie: OIDC_SCOPE + openid + offline_access. Odkomentuj, żeby nadpisać.
# OIDC_SCOPES_REQUESTED=openid offline_access

# Wyłącza walidację tokenu. WYŁĄCZNIE do testów lokalnych.
# Przy SYSTIM_TRANSPORT=http i tej opcji serwer wypisuje głośne ostrzeżenie
# przy każdym starcie. Nie wolno tego wystawiać na publiczny adres — endpoint
# daje pełny dostęp do księgowości firmy.
SYSTIM_AUTH_DISABLED=false


# ─────────────────────────────────────────────────────────────────────────────
# Opcjonalne: limity i zgodność (wartości domyślne wystarczają)
# ─────────────────────────────────────────────────────────────────────────────

# Dodatkowe adresy akceptowane w nagłówku Origin, po przecinku.
# SYSTIM_PUBLIC_URL jest dozwolony zawsze. Żądania bez nagłówka Origin są
# przepuszczane — Origin ustawiają przeglądarki, a Claude łączy się po stronie
# serwera i tego nagłówka nie wysyła.
# SYSTIM_DODATKOWE_ORIGINY=https://claude.ai

# Maksymalna liczba pozycji na jednym dokumencie.
# SYSTIM_MAX_POZYCJI=200

# Maksymalny rozmiar ciała żądania do /mcp, w bajtach.
# SYSTIM_MAX_CIALO=4194304

# Wyłącza wbudowaną w SDK ochronę odrzucającą żądania przychodzące z adresu
# localhost przy nielokalnym nagłówku Host. Ustaw na true tylko wtedy, gdy
# reverse proxy stoi na tym samym hoście w trybie network_mode: host i widzisz
# odrzucenia z kodem 403 mimo poprawnej konfiguracji.
# SYSTIM_WYLACZ_OCHRONE_LOCALHOST=false
